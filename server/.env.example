# SmartRoute AI Backend Configuration

PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# TomTom Routing & Traffic API Credentials
# Get your free developer API key at https://developer.tomtom.com
TOMTOM_API_KEY=your_tomtom_api_key_here
TOMTOM_BASE_URL=https://api.tomtom.com
TIMEOUT_MS=8000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Ranking Weights (Defaults: Time=0.5, Delay=0.3, Distance=0.2)
WEIGHT_TIME=0.5
WEIGHT_DELAY=0.3
WEIGHT_DISTANCE=0.2
